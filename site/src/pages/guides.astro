---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const page = {
  title: "Bootable guides — USB, SD card, Windows, and Omarchy",
  description: "Steps for writing ISO, IMG, Raspberry Pi, compressed, and Windows installer media, plus installing the Omarchy plugin.",
  ogTitle: "Bootable guides",
  ogDescription: "Guides for USB, SD, Windows installers, Omarchy, safety, and verification.",
  ogType: "website",
  current: "guides",
  crumbs: [{ label: "Home", href: "/" }, { label: "Guides" }],
};
---
<Layout {...page}>
<main class="guide-main">
  <Breadcrumbs crumbs={page.crumbs} />
      <header class="guide-hero">
        <p class="eyebrow">Guides</p>
        <h1>Bootable guides</h1>
        <p class="lede">Choose what you want to create or check.</p>
      </header>

      <section class="guide-index" aria-label="All guides">
        <div class="guide-card-grid">
          <a class="guide-card" href="/windows-11-usb-on-linux">
            <span>Windows · Linux</span>
            <h3>Create a Windows 11 USB on Linux</h3>
            <p>Create FAT32 setup media and split oversized WIM files.</p>
          </a>
          <a class="guide-card" href="/windows-11-usb-on-macos">
            <span>Windows · macOS</span>
            <h3>Create a Windows 11 USB on macOS</h3>
            <p>Create FAT32 setup media on an Apple Silicon Mac.</p>
          </a>
          <a class="guide-card" href="/write-iso-to-usb">
            <span>ISO · USB</span>
            <h3>Write an ISO to a USB drive</h3>
            <p>Choose an ISO and drive, then write and verify it.</p>
          </a>
          <a class="guide-card" href="/raspberry-pi-image-writer">
            <span>IMG · SD</span>
            <h3>Write a Raspberry Pi image</h3>
            <p>Download or open an image, then write it to an SD card.</p>
          </a>
          <a class="guide-card" href="/compressed-image-writer">
            <span>XZ · GZ · ZST · BZ2</span>
            <h3>Write compressed disk images</h3>
            <p>Write XZ, gzip, Zstandard, or bzip2 files directly.</p>
          </a>
          <a class="guide-card" href="/verify-bootable-usb">
            <span>Integrity</span>
            <h3>Verify bootable USB media</h3>
            <p>Understand checksums, read-back, and Windows media checks.</p>
          </a>
          <a class="guide-card" href="/safe-usb-writer">
            <span>Safety</span>
            <h3>How Bootable protects disks</h3>
            <p>See which drives are allowed and how writes are approved.</p>
          </a>
          <a class="guide-card" href="/terminal-usb-writer">
            <span>TUI · CLI</span>
            <h3>Write boot media from a terminal</h3>
            <p>Install and use the TUI or CLI.</p>
          </a>
          <a class="guide-card" href="/omarchy-plugin">
            <span>Omarchy · Quickshell</span>
            <h3>Install the Omarchy bar plugin</h3>
            <p>Discover images and follow safe media writes from the Omarchy bar.</p>
          </a>
        </div>
      </section>
</main>
</Layout>
