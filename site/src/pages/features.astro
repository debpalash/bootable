---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const page = {
  title: "Bootable features — Writing, verification, and disk safety",
  description: "See supported image formats, write methods, drive checks, Windows installer options, interfaces, platforms, and current limits.",
  ogTitle: "Bootable features",
  ogDescription: "Supported formats, write tools, platforms, and current limits.",
  ogType: "website",
  current: "features",
  doc: { label: "Roadmap", href: "https://github.com/debpalash/bootable/blob/main/docs/roadmap.md" },
  crumbs: [{ label: "Home", href: "/" }, { label: "Features" }],
};
---
<Layout {...page}>
<main class="guide-main feature-main">
  <Breadcrumbs crumbs={page.crumbs} />
      <header class="guide-hero">
        <p class="eyebrow">v0.1.0-alpha.3</p>
        <h1>Features and limits</h1>
      </header>

      <div class="feature-document">
        <section class="feature-block" id="discovery" aria-labelledby="discovery-title">
          <figure class="feature-visual media-stage media-stage-sage">
            <div class="shot-header"><span>Desktop</span><span>Discovery + downloads</span></div>
            <div class="shot-frame">
              <picture>
                <source media="(prefers-reduced-motion: reduce)" srcset="/gui-discover.png">
                <img src="/gui-demo.gif" alt="Bootable desktop catalog browsing distributions and releases" width="860" height="474">
              </picture>
            </div>
            <figcaption>Image catalog in the desktop app.</figcaption>
          </figure>
          <div class="feature-copy">
            <p class="eyebrow">01 · Discovery</p>
            <h2 id="discovery-title">Catalogs and downloads</h2>
            <dl class="feature-list">
              <div><dt>DistroWatch catalog</dt><dd>Search releases by popularity, Arch, or Debian.</dd></div>
              <div><dt>Other catalogs</dt><dd>Browse Omarchy and Raspberry Pi images.</dd></div>
              <div><dt>Local images</dt><dd>Open ISO, IMG, RAW, or supported archives with native dialogs.</dd></div>
              <div><dt>Downloads</dt><dd>Queue, pause, resume, cancel, and retry downloads.</dd></div>
              <div><dt>Partial downloads</dt><dd>Resume supported transfers and keep download history.</dd></div>
              <div><dt>Publisher checksums</dt><dd>Block files that fail a publisher checksum.</dd></div>
              <div><dt>No checksum</dt><dd>Label the download HTTPS-only.</dd></div>
              <div><dt>Catalog cache</dt><dd>Cache results for 30 minutes. Use stale data if refresh fails.</dd></div>
            </dl>
          </div>
        </section>

        <section class="feature-block reverse" id="planning" aria-labelledby="planning-title">
          <figure class="feature-visual media-stage media-stage-cool">
            <div class="shot-header"><span>Desktop</span><span>Source + target</span></div>
            <div class="shot-frame">
              <img src="/gui-discover.png" alt="Bootable desktop source and removable-drive selection" width="1638" height="904" loading="lazy">
            </div>
            <figcaption>Source and drive selection.</figcaption>
          </figure>
          <div class="feature-copy">
            <p class="eyebrow">02 · Plan</p>
            <h2 id="planning-title">Source and drive checks</h2>
            <dl class="feature-list">
              <div><dt>Seven source formats</dt><dd>ISO, IMG, RAW, XZ, gzip, Zstandard, and bzip2.</dd></div>
              <div><dt>Expanded size</dt><dd>Measure compressed images before checking drive capacity.</dd></div>
              <div><dt>Whole drives</dt><dd>Accept only whole USB or removable drives.</dd></div>
              <div><dt>Drive refresh</dt><dd>Rescan while idle. Lock the drive list while writing.</dd></div>
              <div><dt>Rejected drives</dt><dd>Reject fixed, read-only, system, and undersized drives.</dd></div>
              <div><dt>Write review</dt><dd>Show the source, drive, method, operations, and data loss.</dd></div>
              <div><dt>Confirmation</dt><dd>Require approval for the selected drive and plan.</dd></div>
              <div><dt>Identity recheck</dt><dd>Find the drive again by stable ID before writing.</dd></div>
              <div><dt>Administrator access</dt><dd>Elevate only the fixed write helper.</dd></div>
            </dl>
          </div>
        </section>

        <section class="feature-block" id="writing" aria-labelledby="writing-title">
          <figure class="feature-visual media-stage media-stage-sand">
            <div class="shot-header"><span>TUI</span><span>Write + drive tools</span></div>
            <div class="shot-frame tui-still-crop">
              <img src="/tui-main.png" alt="Bootable terminal interface with source, drive, and review controls" width="1902" height="1954" loading="lazy">
            </div>
            <figcaption>Write controls in the terminal app.</figcaption>
          </figure>
          <div class="feature-copy">
            <p class="eyebrow">03 · Write</p>
            <h2 id="writing-title">Raw writing and drive tools</h2>
            <dl class="feature-list">
              <div><dt>Raw images</dt><dd>Write ISO, IMG, and RAW files directly.</dd></div>
              <div><dt>Compressed images</dt><dd>Write XZ, gzip, Zstandard, and bzip2 without extracting them first.</dd></div>
              <div><dt>Read-back</dt><dd>Read the written range and compare SHA-256.</dd></div>
              <div><dt>Cancellation</dt><dd>Stop at a safe boundary and mark the drive incomplete.</dd></div>
              <div><dt>Progress</dt><dd>Show phase, bytes, speed, ETA, verification, and safe removal.</dd></div>
              <div><dt>Bad-block checks</dt><dd>One, two, or four destructive patterns on Linux.</dd></div>
              <div><dt>Fake-capacity checks</dt><dd>Test the full drive on Linux. This erases the drive.</dd></div>
              <div><dt>Drive backup</dt><dd>Create RAW, IMG, or DD backups on Linux and macOS.</dd></div>
            </dl>
          </div>
        </section>

        <section class="feature-block reverse" id="windows" aria-labelledby="windows-title">
          <figure class="feature-visual media-stage media-stage-cool">
            <div class="shot-header"><span>TUI</span><span>Windows + Raspberry Pi</span></div>
            <div class="shot-frame tui-motion-crop">
              <picture>
                <source media="(prefers-reduced-motion: reduce)" srcset="/tui-main.png">
                <img src="/tui-demo.gif" alt="Bootable terminal interface showing Windows and Raspberry Pi modes" width="860" height="538" loading="lazy">
              </picture>
            </div>
            <figcaption>Windows installer options in the TUI.</figcaption>
          </figure>
          <div class="feature-copy">
            <p class="eyebrow">04 · Windows installers</p>
            <h2 id="windows-title">FAT32 Windows media</h2>
            <dl class="feature-list">
              <div><dt>GPT or MBR</dt><dd>Create a FAT32 partition for UEFI setup.</dd></div>
              <div><dt>UDF sources</dt><dd>Read UDF-only Windows ISOs with 7-Zip.</dd></div>
              <div><dt>WIM splitting</dt><dd>Split oversized <code>install.wim</code> files for FAT32.</dd></div>
              <div><dt>Source checks</dt><dd>Reject missing boot files, collisions, and oversized files.</dd></div>
              <div><dt>Media checks</dt><dd>Check UEFI files, payloads, WIM parts, and FAT32 limits.</dd></div>
              <div><dt>Setup options</dt><dd>Configure hardware, account, region, privacy, BitLocker, and policy options.</dd></div>
              <div><dt>WIM tools</dt><dd>Use DISM, <code>wimtools</code>, or <code>wimlib</code>.</dd></div>
              <div><dt>Firmware</dt><dd>UEFI only. Legacy BIOS is not supported.</dd></div>
            </dl>
          </div>
        </section>

        <section class="feature-block" id="interfaces" aria-labelledby="interfaces-feature-title">
          <figure class="feature-visual media-stage media-stage-sage">
            <div class="shot-header"><span>Desktop</span><span>Filters + search</span></div>
            <div class="shot-frame toolbar-crop">
              <img src="/gui-toolbar.png" alt="Bootable desktop catalog filters and search controls" width="2301" height="229" loading="lazy">
            </div>
            <figcaption>Catalog filters and search.</figcaption>
          </figure>
          <div class="feature-copy">
            <p class="eyebrow">05 · Interfaces</p>
            <h2 id="interfaces-feature-title">GUI, TUI, and CLI</h2>
            <dl class="feature-list">
              <div><dt>Desktop app</dt><dd>Mouse controls, native file dialogs, and background tasks.</dd></div>
              <div><dt>Terminal app</dt><dd>Keyboard and mouse controls with the same write and drive tools.</dd></div>
              <div><dt>CLI</dt><dd>Inspect images, list drives, review plans, and run supported operations.</dd></div>
              <div><dt>GUI and TUI</dt><dd>Use the same labels, plans, progress, errors, and options.</dd></div>
              <div><dt>Linux</dt><dd>Supports backup, Windows media, and drive tests.</dd></div>
              <div><dt>Windows</dt><dd>Supports raw images and Windows media.</dd></div>
              <div><dt>macOS</dt><dd>Supports raw images, backup, and Windows media.</dd></div>
              <div><dt>Developer tests</dt><dd>Includes QEMU/OVMF boot tests and a loop-device write test.</dd></div>
            </dl>
          </div>
        </section>

        <section class="feature-limits" aria-labelledby="limits-title">
          <div>
            <p class="eyebrow">Limits</p>
            <h2 id="limits-title">Not supported</h2>
          </div>
          <ul>
            <li>Platform code signing and macOS notarization</li>
            <li>Legacy BIOS helpers for constructed Windows media</li>
            <li>Linux persistence and persistent multiboot</li>
            <li>Windows To Go</li>
            <li>DOS and FreeDOS media</li>
            <li>VHD, VHDX, and FFU backup</li>
            <li>OpenPGP or minisign publisher verification</li>
            <li>Localization</li>
            <li>General-purpose FAT, NTFS, UDF, exFAT, or ext formatting</li>
            <li>Official ISO and UEFI Shell downloads</li>
            <li>Silent unattended installation</li>
          </ul>
        </section>

        <div class="feature-actions">
          <a class="button primary" href="/download">Download Bootable</a>
          <a class="button secondary" href="/guides">Read the guides</a>
          <a class="text-link" href="https://github.com/debpalash/bootable/blob/main/docs/rufus-parity.md">View implementation status →</a>
        </div>
      </div>
</main>
</Layout>
