---
interface Props {
  /** Home page variant: brand anchors to #top, nav omits Home. */
  home?: boolean;
  /** Active nav item. */
  current?: 'features' | 'guides' | 'download' | 'faq' | 'guide';
}
const { home = false, current } = Astro.props;
const homeHref = home ? '#top' : '/';
---
<header class="site-header">
  <a class="brand" href={homeHref} aria-label="Bootable home">
    <img src="/favicon.svg" alt="" width="34" height="34">
    <span>bootable</span>
    <small>v0.1.1</small>
  </a>
  <nav aria-label="Primary navigation">
    {!home && <a class="nav-home" href="/">home</a>}
    <a href="/features" aria-current={current === 'features' ? 'page' : undefined}>features</a>
    <a href="/guides" aria-current={current === 'guides' || current === 'guide' ? 'page' : undefined}>guides</a>
    <a class="nav-source" href="https://github.com/debpalash/bootable">source ↗</a>
    <a class="nav-download" href="/download" aria-current={current === 'download' ? 'page' : undefined}>download ↓</a>
  </nav>
</header>
